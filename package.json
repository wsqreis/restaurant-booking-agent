{
  "name": "restaurant-booking-agent",
  "version": "0.1.0",
  "description": "Conversational table-booking agent for a restaurant: LangGraph state machine, deterministic booking rules, OpenRouter LLMs",
  "scripts": {
    "start": "node --env-file=.env src/index.ts",
    "dev": "node --watch --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test node --test tests/*.test.ts",
    "eval": "node --env-file=.env eval/run.ts"
  },
  "author": "wsqreis",
  "license": "MIT",
  "dependencies": {
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.5.0",
    "@langchain/openai": "^1.6.2",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  }
}
